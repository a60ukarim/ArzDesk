{
  "name": "arzdesk-desktop",
  "version": "1.0.1",
  "description": "ArzDesk offline desktop application",
  "productName": "ArzDesk",
  "main": "main.cjs",
  "private": true,
  "author": "ArzCore Technologies",
  "license": "MIT",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.arzcore.arzdesk",
    "productName": "ArzDesk",
    "directories": {
      "output": "../dist-windows"
    },
    "files": [
      "main.cjs",
      "package.json",
      "smoke.cjs",
      "navigation.cjs",
      "online-account.cjs",
      "online-smoke.cjs"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "app-bundle"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ArzDesk-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ArzDesk",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "ArzDesk-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "identity": null,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "icon": "build/icon.icns"
    }
  }
}
