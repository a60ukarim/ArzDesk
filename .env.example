DATABASE_URL=postgresql://arzdesk:arzdesk@localhost:5432/arzdesk
# Generate: openssl rand -base64 32 (or see README for a Node.js equivalent)
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# To test on a phone over Wi-Fi, set this to the laptop's LAN URL, e.g.
# BETTER_AUTH_URL=http://192.168.1.8:3000
# Then restart: npm run dev -- --hostname 0.0.0.0
# Localhost stays available during development; LAN trust is not added in production.

# Account recovery and email-change confirmation (SMTP). Development uses terminal links.
# Production needs SMTP_HOST and MAIL_FROM; console delivery is never enabled there.
MAIL_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional: reviewed R2 HTTPS origin. No installer activates without physical QA in releases/approved-installers.json.
ARZDESK_RELEASES_BASE_URL=
